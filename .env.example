# TokenCap Environment Configuration
PORT=8787

# Dashboard Authentication Credentials (default: admin / admin if not set)
TOKENCAP_DASHBOARD_USER=admin
TOKENCAP_DASHBOARD_PASSWORD=admin

# HMAC Session Secret (optional - falls back to secure derivative)
# TOKENCAP_SESSION_SECRET=your_random_64_char_secret_here

# Provider API Keys (optional fallback defaults)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
