{
  "name": "tokencap",
  "version": "1.0.0",
  "description": "Lightweight self-hosted proxy to prevent AI agent runaway token usage and budget overflow.",
  "main": "dist/index.js",
  "bin": {
    "tokencap": "./bin/tokencap.js"
  },
  "files": [
    "dist",
    "bin",
    "llms.txt",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts start",
    "build": "tsc",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/ test/",
    "format": "biome format --write src/ test/",
    "test": "tsx --test test/**/*.test.ts"
  },
  "keywords": [
    "ai",
    "agent",
    "proxy",
    "token-cap",
    "finops",
    "rate-limit",
    "budget",
    "antigravity",
    "openai",
    "anthropic",
    "gemini"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.5",
    "hono": "^4.13.13",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/better-sqlite3": "^9.6.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
